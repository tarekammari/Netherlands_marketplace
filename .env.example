# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="TaskBridge NL"

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (use Neon / Supabase / self-hosted)
DATABASE_URL="postgresql://neondb_owner:npg_6nuwQxmFd9yU@ep-lucky-band-ay8gke6g-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Separate connection for migrations (not pooled)
DIRECT_URL="postgresql://neondb_owner:npg_6nuwQxmFd9yU@ep-lucky-band-ay8gke6g-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
AUTH_SECRET="replace-with-64-char-random-string"
AUTH_URL=http://localhost:3000

# OAuth providers (optional but recommended)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_LINKEDIN_CLIENT_ID=""
AUTH_LINKEDIN_CLIENT_SECRET=""

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Server-side ONLY — never prefix with NEXT_PUBLIC_
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Platform fee percentage (e.g. 10 = 10%)
STRIPE_PLATFORM_FEE_PERCENT=10

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
EMAIL_FROM="no-reply@taskbridge.nl"

# ─── File Storage (Cloudflare R2 / AWS S3) ────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="taskbridge-files"
R2_PUBLIC_URL="https://files.taskbridge.nl"

# ─── Rate Limiting (Upstash Redis) ───────────────────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Encryption ───────────────────────────────────────────────────────────────
# 32-character AES-256 key — generate with: openssl rand -hex 16
FIELD_ENCRYPTION_KEY="replace-with-32-char-hex-key"

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
